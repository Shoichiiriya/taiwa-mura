---
interface Props {
  title: string;
  date: Date;
  location?: string;
  description: string;
  applyUrl?: string;
  slug: string;
}

const { title, date, location, description, applyUrl, slug } = Astro.props;

const month = date.toLocaleDateString('ja-JP', { month: 'short' });
const day = date.getDate();
const weekday = date.toLocaleDateString('ja-JP', { weekday: 'short' });
const year = date.getFullYear();
---

<article class="event-card">
  <div class="event-date" aria-hidden="true">
    <span class="event-month">{month}</span>
    <span class="event-day">{day}</span>
    <span class="event-weekday">{weekday}</span>
  </div>
  <div class="event-body">
    <p class="event-fulldate">{year}年{month}{day}日（{weekday}）</p>
    <h3 class="event-title">
      <a href={`/events/${slug}`}>{title}</a>
    </h3>
    {location && <p class="event-location">📍 {location}</p>}
    <p class="event-desc">{description}</p>
    {applyUrl && (
      <a href={applyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary event-apply">
        申し込む →
      </a>
    )}
  </div>
</article>

<style>
  .event-card {
    display: flex;
    gap: 1.3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 1.4rem;
    transition: box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .event-card:hover { box-shadow: var(--shadow-soft); border-color: var(--color-brand-light); }

  .event-date {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1rem;
    background: var(--color-brand);
    color: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
  }
  .event-month { font-size: 0.7rem; }
  .event-day { font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; }
  .event-weekday { font-size: 0.65rem; opacity: 0.85; }

  .event-body { flex: 1; min-width: 0; }
  .event-fulldate { font-size: 0.75rem; color: var(--color-muted); }
  .event-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 0.2rem;
  }
  .event-title a { color: var(--color-text); text-decoration: none; }
  .event-title a:hover { color: var(--color-brand); }
  .event-location { font-size: 0.85rem; color: var(--color-muted); margin-top: 0.3rem; }
  .event-desc {
    font-size: 0.9rem;
    color: var(--color-text);
    margin-top: 0.5rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .event-apply { margin-top: 0.9rem; padding: 0.5rem 1.2rem; font-size: 0.85rem; }

  @media (max-width: 520px) {
    .event-date { width: 3.8rem; height: 3.8rem; }
    .event-day { font-size: 1.4rem; }
  }
</style>
