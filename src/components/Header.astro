---
const navLinks = [
  { href: '/', label: 'ホーム' },
  { href: '/activities', label: '活動' },
  { href: '/events', label: 'イベント' },
  { href: '/links', label: 'リンク' },
  { href: '/about', label: 'About' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header">
  <div class="container-base header-inner">
    <a href="/" class="brand">たいわ村</a>

    <nav class="nav-desktop" aria-label="メインナビゲーション">
      <ul>
        {navLinks.map(link => (
          <li>
            <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/events" class="btn btn-primary header-cta">イベント</a>

    <button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile" aria-label="モバイルナビゲーション">
    <ul>
      {navLinks.map(link => (
        <li>
          <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: oklch(96.5% 0.014 92 / 0.82);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.2rem;
  }
  .brand {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-text);
  }
  .nav-desktop ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-muted);
    position: relative;
    padding-bottom: 0.2rem;
    transition: color 0.18s ease;
  }
  .nav-link:hover { color: var(--color-text); }
  .nav-link.active { color: var(--color-brand); font-weight: 600; }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-brand);
  }
  .header-cta { padding: 0.5rem 1.2rem; font-size: 0.85rem; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-text);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .nav-mobile {
    display: none;
    border-top: 1px solid var(--color-border);
  }
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.5rem 1rem;
  }
  .nav-mobile li { border-bottom: 1px solid var(--color-border); }
  .nav-mobile li:last-child { border-bottom: none; }
  .nav-mobile .nav-link {
    display: block;
    padding: 0.9rem 0.2rem;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .nav-desktop, .header-cta { display: none; }
    .nav-toggle { display: flex; }
    .site-header.open .nav-mobile { display: block; }
    .site-header.open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .site-header.open .nav-toggle span:nth-child(2) { opacity: 0; }
    .site-header.open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
