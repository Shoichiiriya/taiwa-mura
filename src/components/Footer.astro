---
const year = new Date().getFullYear();
const nav = [
  { href: '/activities', label: '活動' },
  { href: '/events', label: 'イベント' },
  { href: '/links', label: 'リンク' },
  { href: '/about', label: 'About' },
];
---

<footer class="site-footer">
  <div class="container-base footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">たいわ村</p>
      <p class="footer-tagline">問い、歩き、語り合う場所</p>
    </div>
    <nav class="footer-nav" aria-label="フッターナビゲーション">
      {nav.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
  <div class="footer-bottom">
    <p>© {year} たいわ村</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--color-brand-light);
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }
  .footer-tagline {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer-nav a {
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .footer-nav a:hover { color: var(--color-brand); }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.2rem 1.5rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
</style>
