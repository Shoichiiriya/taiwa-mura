---
import Layout from '../layouts/Layout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter(e => new Date(e.data.date) >= new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 3);

const activities = await getCollection('activities');
const sortedActivities = activities.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="ホーム">
  <!-- ヒーロー -->
  <section class="hero">
    <div class="container-base hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">対話の文化を育むコミュニティ</p>
        <h1 class="hero-title">問い、歩き、<br />語り合う場所</h1>
        <p class="hero-lead">
          たいわ村は、哲学対話・対話散歩・読書会などを通じて、<br class="pc-only" />
          答えを急がず、共に問い続ける時間を育んでいます。
        </p>
        <div class="hero-actions">
          <a href="/events" class="btn btn-primary">イベントを見る</a>
          <a href="/about" class="btn btn-ghost">たいわ村とは</a>
        </div>
      </div>
      <div class="hero-visual reveal">
        <div class="img-slot hero-img">
          <img src="/images/hero.jpg" alt="対話散歩の様子" onerror="this.remove()" />
        </div>
        <div class="hero-blob" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- イントロ -->
  <section class="intro">
    <div class="container-narrow intro-inner">
      <p class="intro-text">
        「対話」とは、勝ち負けや結論のためではなく、<br class="pc-only" />
        相手と自分のあいだに新しい問いを見つけるための営みです。
      </p>
      <p class="intro-text">
        たいわ村は、そんな対話の場を日常のなかに開き続けています。
      </p>
    </div>
  </section>

  <!-- 活動 -->
  <section class="container-base section">
    <div class="section-head">
      <p class="eyebrow">Activities</p>
      <h2 class="section-title">活動</h2>
    </div>
    <div class="activity-grid">
      {sortedActivities.map(activity => (
        <ActivityCard
          title={activity.data.title}
          tagline={activity.data.tagline}
          frequency={activity.data.frequency}
          slug={activity.id}
        />
      ))}
    </div>
  </section>

  <!-- 直近イベント -->
  {upcomingEvents.length > 0 && (
    <section class="container-base section">
      <div class="section-head row">
        <div>
          <p class="eyebrow">Events</p>
          <h2 class="section-title">直近のイベント</h2>
        </div>
        <a href="/events" class="see-all">すべて見る →</a>
      </div>
      <div class="event-list">
        {upcomingEvents.map(event => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            location={event.data.location}
            description={event.data.description}
            applyUrl={event.data.applyUrl}
            slug={event.id}
          />
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="container-base">
    <div class="cta">
      <h2 class="cta-title">まずは、ひとつの問いから。</h2>
      <p class="cta-lead">はじめての方も、ひとりでの参加も歓迎しています。</p>
      <div class="hero-actions">
        <a href="/events" class="btn btn-primary">イベントに参加する</a>
        <a href="/links" class="btn btn-ghost">SNS・お問い合わせ</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- ヒーロー --- */
  .hero { padding: 3.5rem 0 4rem; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 1.25;
    margin-top: 1rem;
    color: var(--color-text);
  }
  .hero-lead {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 2;
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-visual { position: relative; }
  .hero-img {
    aspect-ratio: 4 / 5;
    border-radius: 1.75rem;
    box-shadow: var(--shadow-lift);
  }
  .hero-blob {
    position: absolute;
    width: 60%;
    height: 60%;
    right: -8%;
    bottom: -10%;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, oklch(72% 0.09 60 / 0.35), transparent 70%);
    filter: blur(20px);
    z-index: -1;
  }

  /* --- イントロ --- */
  .intro { padding: 1rem 0 1rem; text-align: center; }
  .intro-text {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    line-height: 2.1;
    color: var(--color-text);
  }
  .intro-text + .intro-text { margin-top: 1.2rem; }

  /* --- セクション共通 --- */
  .section { padding-top: 3.5rem; }
  .section-head { margin-bottom: 1.8rem; }
  .section-head.row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .section-title { font-size: 1.7rem; margin-top: 0.3rem; color: var(--color-text); }
  .see-all { font-size: 0.9rem; color: var(--color-brand); text-decoration: none; white-space: nowrap; }
  .see-all:hover { color: var(--color-brand-dark); }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .event-list { display: flex; flex-direction: column; gap: 1.1rem; }

  /* --- CTA --- */
  .cta {
    margin-top: 4rem;
    background: var(--color-brand);
    color: var(--color-surface);
    border-radius: 2rem;
    padding: 3.5rem 2rem;
    text-align: center;
  }
  .cta-title { font-size: clamp(1.6rem, 4vw, 2.2rem); color: var(--color-surface); }
  .cta-lead { margin-top: 0.9rem; font-size: 1rem; opacity: 0.9; }
  .cta .hero-actions { justify-content: center; }
  .cta .btn-ghost {
    border-color: oklch(99% 0 0 / 0.4);
    color: var(--color-surface);
  }
  .cta .btn-ghost:hover { background: oklch(99% 0 0 / 0.12); color: var(--color-surface); }

  .pc-only { display: inline; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.2rem; }
    .hero-visual { max-width: 26rem; margin-inline: auto; width: 100%; }
    .pc-only { display: none; }
  }
</style>
