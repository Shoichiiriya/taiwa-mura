---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const activities = await getCollection('activities');
  return activities.map(activity => ({
    params: { slug: activity.id },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { Content } = await render(activity);
---

<Layout title={activity.data.title} description={activity.data.tagline}>
  <article class="container-narrow page">
    <a href="/activities" class="back-link">← 活動一覧</a>

    <div class="img-slot detail-hero">
      <img src={`/images/activities/${activity.id}.jpg`} alt="" onerror="this.remove()" />
    </div>

    <header class="detail-head">
      <h1 class="detail-title">{activity.data.title}</h1>
      <p class="detail-tagline">{activity.data.tagline}</p>
      {activity.data.frequency && (
        <span class="detail-freq">{activity.data.frequency}</span>
      )}
    </header>

    <div class="prose detail-body">
      <Content />
    </div>

    <div class="detail-cta">
      <a href="/events" class="btn btn-primary">イベントを見る →</a>
    </div>
  </article>
</Layout>

<style>
  .page { padding: 2.5rem 0 2rem; }
  .back-link {
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-brand); }
  .detail-hero {
    aspect-ratio: 16 / 9;
    border-radius: 1.5rem;
    margin-top: 1.5rem;
    box-shadow: var(--shadow-soft);
  }
  .detail-head { margin-top: 2rem; }
  .detail-title { font-size: 2rem; color: var(--color-text); }
  .detail-tagline { color: var(--color-muted); margin-top: 0.5rem; font-size: 1.05rem; }
  .detail-freq {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--color-brand-dark);
    background: var(--color-brand-light);
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
  }
  .detail-body { margin-top: 2.2rem; }
  .detail-cta {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
