---
import Layout from '../../layouts/Layout.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { getCollection } from 'astro:content';

const activities = await getCollection('activities');
const sorted = activities.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="活動" description="たいわ村の活動一覧。哲学対話・対話散歩・読書会・ZINEなど。">
  <div class="container-base page">
    <header class="page-head">
      <p class="eyebrow">Activities</p>
      <h1 class="page-title">活動</h1>
      <p class="page-lead">たいわ村では、さまざまなかたちの対話の場を開いています。</p>
    </header>

    <div class="activity-grid">
      {sorted.map(activity => (
        <ActivityCard
          title={activity.data.title}
          tagline={activity.data.tagline}
          frequency={activity.data.frequency}
          comingSoon={activity.data.comingSoon}
          slug={activity.id}
        />
      ))}
    </div>
  </div>
</Layout>

<style>
  .page { padding: 3.5rem 0 2rem; }
  .page-head { margin-bottom: 2.5rem; }
  .page-title { font-size: 2.2rem; margin-top: 0.4rem; color: var(--color-text); }
  .page-lead { margin-top: 0.8rem; color: var(--color-muted); line-height: 1.8; }
  .activity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
</style>
