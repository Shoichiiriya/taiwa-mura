---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();

const upcoming = allEvents
  .filter(e => new Date(e.data.date) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const past = allEvents
  .filter(e => new Date(e.data.date) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="イベント" description="たいわ村のイベント一覧・申し込み情報。">
  <div class="container-narrow page">
    <header class="page-head">
      <p class="eyebrow">Events</p>
      <h1 class="page-title">イベント</h1>
      <p class="page-lead">気になる回に、ひとつだけでもお気軽にどうぞ。</p>
    </header>

    {upcoming.length > 0 ? (
      <section class="block">
        <h2 class="block-title">開催予定</h2>
        <div class="event-list">
          {upcoming.map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
              applyUrl={event.data.applyUrl}
              slug={event.id}
            />
          ))}
        </div>
      </section>
    ) : (
      <p class="empty">現在、開催予定のイベントはありません。</p>
    )}

    {past.length > 0 && (
      <section class="block">
        <h2 class="block-title">過去のイベント</h2>
        <div class="event-list">
          {past.map(event => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              description={event.data.description}
              slug={event.id}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .page { padding: 3.5rem 0 2rem; }
  .page-head { margin-bottom: 2.5rem; }
  .page-title { font-size: 2.2rem; margin-top: 0.4rem; color: var(--color-text); }
  .page-lead { margin-top: 0.8rem; color: var(--color-muted); line-height: 1.8; }
  .block { margin-bottom: 3rem; }
  .block-title {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 1.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .event-list { display: flex; flex-direction: column; gap: 1.1rem; }
  .empty { color: var(--color-muted); padding: 2rem 0; }
</style>
