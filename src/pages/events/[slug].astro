---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const dateStr = event.data.date.toLocaleDateString('ja-JP', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'short',
});
---

<Layout title={event.data.title} description={event.data.description}>
  <article class="container-narrow page">
    <a href="/events" class="back-link">← イベント一覧</a>

    <header class="detail-head">
      <time class="detail-date">{dateStr}</time>
      <h1 class="detail-title">{event.data.title}</h1>
      {event.data.location && <p class="detail-location">📍 {event.data.location}</p>}
    </header>

    <div class="prose detail-body">
      <Content />
    </div>

    {event.data.applyUrl && (
      <div class="detail-cta">
        <a href={event.data.applyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          申し込む →
        </a>
      </div>
    )}
  </article>
</Layout>

<style>
  .page { padding: 2.5rem 0 2rem; }
  .back-link { font-size: 0.85rem; color: var(--color-muted); text-decoration: none; }
  .back-link:hover { color: var(--color-brand); }
  .detail-head { margin-top: 1.8rem; }
  .detail-date { display: block; font-size: 0.85rem; color: var(--color-muted); }
  .detail-title { font-size: 2rem; margin-top: 0.5rem; color: var(--color-text); }
  .detail-location { color: var(--color-muted); margin-top: 0.4rem; }
  .detail-body { margin-top: 2.2rem; }
  .detail-cta {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
